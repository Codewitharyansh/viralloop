# --- Port the Viraloop server runs on ---
PORT=4000

# --- Optional: Instagram publishing ---
# Viraloop's image generation and "publish" step work fully for FREE with
# no keys at all (images are rendered locally, and publish is logged
# locally instead of actually posting). If you later want to wire up real
# Instagram publishing, that requires Meta's Graph API (a Facebook
# Developer app + a connected Instagram Business account), which is a
# separate integration from anything below.
#
# IG_USERNAME is just a label used in the UI/caption; it does not need to
# be a real, verified account for the app to work.
IG_USERNAME=your_instagram_handle
